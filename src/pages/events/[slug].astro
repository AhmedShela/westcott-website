---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InfoBox from '../../components/InfoBox.astro';
import { formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map((e) => ({ params: { slug: e.id }, props: { event: e } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const d = event.data;
const when = [formatDate(d.date, d.endDate), d.time].filter(Boolean).join(', ');
const links = [...d.links, ...(d.program ? [{ label: 'About this program', url: `/programs/${d.program}/` }] : [])];
---
<Base title={d.title} description={d.summary} image={d.image}>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow"><a href="/events/">Events</a></p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
    </div>
  </div>
  <div class="section">
    <div class="wrap two-col">
      <div class="prose">
        {d.image && <img src={d.image} alt={d.imageAlt ?? ''} />}
        <Content />
      </div>
      <InfoBox schedule={when} location={d.location} links={links} />
    </div>
  </div>
</Base>
<style>.eyebrow a { color: inherit; text-decoration: none; } .prose img { margin-top: 0; }</style>
