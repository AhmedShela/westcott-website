---
import Base from '../../layouts/Base.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import { getPrograms, categoryOrder } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
const programs = await getPrograms();
const groups = categoryOrder.map((c) => ({ id: c, label: t(`cat.${c}`), items: programs.filter((p) => p.data.category === c) })).filter((g) => g.items.length);
---
<Base title={t('nav.programs')} description="Food, senior services, youth programs, job training, legal help, arts and more at Westcott Community Center.">
  <div class="page-head">
    <div class="wrap">
      <h1>{t('nav.programs')}</h1>
      <p class="lead">Free and low-cost services for neighbors of every age.</p>
      <nav aria-label="Program categories" class="jump">
        {groups.map((g) => <a href={`#${g.id}`}>{g.label}</a>)}
      </nav>
    </div>
  </div>
  {groups.map((g, i) => (
    <section class={i % 2 ? 'section alt' : 'section'} id={g.id} aria-labelledby={`h-${g.id}`}>
      <div class="wrap">
        <h2 id={`h-${g.id}`} class="first">{g.label}</h2>
        <div class="grid">{g.items.map((p) => <ProgramCard program={p} />)}</div>
      </div>
    </section>
  ))}
</Base>
<style>
  .first { margin-top: 0; }
  .jump { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .jump a { padding: .45rem .9rem; border: 1px solid var(--line); border-radius: 999px; background: #fff; text-decoration: none; font-weight: 600; color: var(--ink); }
  .jump a:hover { border-color: var(--red); color: var(--red-dark); }
</style>
