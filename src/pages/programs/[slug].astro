---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InfoBox from '../../components/InfoBox.astro';
import { getPrograms } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const programs = await getPrograms();
  return programs.map((p) => ({ params: { slug: p.id }, props: { program: p } }));
}
const { program } = Astro.props;
const t = useTranslations('en');
const { Content } = await render(program);
const d = program.data;
const isLogo = d.image && /logo|\.png$/i.test(d.image);
---
<Base title={d.title} description={d.summary} image={d.image}>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow"><a href={`/programs/#${d.category}`}>{t(`cat.${d.category}`)}</a></p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      {d.externalUrl && <a class="btn" href={d.externalUrl} rel="noopener">{t('program.visit')}</a>}
    </div>
  </div>
  <div class="section">
    <div class="wrap two-col">
      <div class="prose">
        {d.image && <img src={d.image} alt={d.imageAlt ?? ''} class={isLogo ? 'logo' : 'hero-img'} />}
        <Content />
      </div>
      <InfoBox schedule={d.schedule} location={d.location} contacts={d.contacts} links={d.links}
        when={t('program.when')} where={t('program.where')} contactLabel={t('program.contact')} moreLabel={t('program.more')} />
    </div>
  </div>
</Base>
<style>
  .eyebrow a { color: inherit; text-decoration: none; }
  .hero-img { width: 100%; max-height: 520px; object-fit: contain; background: var(--cream); margin-top: 0 !important; }
  .logo { max-width: 260px; margin-top: 0 !important; }
</style>
