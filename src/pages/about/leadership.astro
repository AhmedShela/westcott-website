---
import Base from '../../layouts/Base.astro';
import people from '../../data/people.json';
import { useTranslations } from '../../i18n/ui';
const t = useTranslations('en');
---
<Base title={t('nav.leadership')} description="The leadership team and Board of Directors of Westcott Community Center.">
  <div class="page-head"><div class="wrap"><p class="eyebrow"><a href="/about/">{t('nav.about')}</a></p><h1>{t('nav.leadership')}</h1></div></div>
  <section class="section" aria-labelledby="h-staff">
    <div class="wrap">
      <h2 id="h-staff" class="first">{t('leadership.staff')}</h2>
      <ul class="people">{people.staff.map((p) => <li><strong>{p.name}</strong>{p.title && <span>{p.title}</span>}</li>)}</ul>
    </div>
  </section>
  <section class="section alt" aria-labelledby="h-board">
    <div class="wrap">
      <h2 id="h-board" class="first">{t('leadership.board')}</h2>
      <ul class="people">{people.board.map((p: { name: string; title?: string }) => <li><strong>{p.name}</strong>{p.title && <span>{p.title}</span>}</li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .first { margin-top: 0; }
  .eyebrow a { color: inherit; text-decoration: none; }
  .people { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .people li { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.1rem; display: flex; flex-direction: column; }
  .people strong { font-family: var(--font-head); }
  .people span { color: var(--ink-soft); }
</style>
